# Password for /admin
ADMIN_PASSWORD=change-me

# Public address of the site; used for the link in the SMS
PUBLIC_URL=https://halloween.example.nl

# SMS Gateway for Android. Leave SMS_GATEWAY_URL empty to only log messages (test mode).
# Local server mode (phone on the same network as this server):
SMS_GATEWAY_URL=http://<phone-ip>:8080/message
# Cloud mode:
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=change-me
